<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_blue"
    android:orientation="vertical"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@color/transparent"
            android:contentDescription="@string/home"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tvDifficultyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="DIFFICULTY"
            android:textColor="@color/yellow_accent"
            android:textSize="26sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Each difficulty has 15 stages"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnEasy"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_button_green"
        android:text="EASY  •  5 Lives"
        android:textColor="@color/white"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnNormal"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_yellow"
        android:text="NORMAL  •  4 Lives"
        android:textColor="@color/text_dark"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnHard"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_white"
        android:text="HARD  •  3 Lives"
        android:textColor="@color/deep_blue"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnExpert"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_white"
        android:text="EXPERT  •  2 Lives"
        android:textColor="@color/deep_blue"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnExtreme"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_box_wrong"
        android:text="EXTREME  •  1 Life"
        android:textColor="@color/white"
        android:textStyle="bold" />

</LinearLayout>
